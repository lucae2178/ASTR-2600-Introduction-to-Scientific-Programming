def acceleration (list): #defining the function to take in a position and output an accleration
    '''
    ---input-----
    this function takes the input of 1 list

    ----process-----
    This function converts the inputted list to a numpy array 
    then it outputs a total acceleration using the pythagorean theorum

    ----output------
    this function returns a single float output that represents the accelration
    of a point in 3 dimentions


    '''
    array1 = np.array(list)
    a = np.sqrt(array1[0]**2 + array1[1]**2 + array1[2]**2)
    return a
