def grav_force(mass1, mass2, pos1, pos2):
    '''
    --------inputs------------
    mass1 = integer or float
    mass1 is the value of the mass of the 1st object

    mass2 = integer or float
    mass2 is the value of the mass of the 2nd object

    pos1 = list or array
    pos1 is the value of the position of the 1st object

    pos2 = list or array
    pos2 is the value of the position of the 2md object

    --------function---------------

    The function first begins by defining G 
    The gravitational constant

    The function then uses the separation function to
    determine an array for the separation between pos1 and pos2

    The function then uses the acceleration function to calculate
    the magnitude of the separation vector. This magnitude is then
    assigned to radius

    Then the function, grav_force, uses Newtons 
    law of universal gravitation to calculate the
    non-relativistic magnitude of the gravitational force
    between the two objects

    -----output---------------
    The function returns a value with three decimal points
    precision. This value is the Newtons of gravitational
    The force felt by each of the two objects due to the gravity
    of the other object

    '''

    G = 6.6743e-11 #m^3kg^-1s^-2 gravitational constant
    
    AU = acceleration(separation_vector(pos1, pos2)) #returns the magnitude of the sepertion vector in AU

    radius = AU*1.496e+11
   
    
    
    #netwons law of universal gravitation
    force = (G * mass1*mass2)/(radius**2)         #calculating the force
    force_exp = f"{force:.3e}"   #changing the result ito exponetial notation
    return(force_exp)

    
