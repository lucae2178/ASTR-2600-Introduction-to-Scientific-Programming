def grav_force_mag(mass1, mass2, radius):
    '''
    --------inputs------------
    mass1 = integer or float
    mass1 is the value of the mass of the 1st object

    mass2 = integer or float
    mass2 is the value of the mass of the 2nd object

    radius = integer or float
    radius is the distance between the two onjects

    --------function---------------

    the function first begins by defining G 
    the gravitational constant

    Then the function, grav_force_mag, uses Newtons 
    law of universal gravitation to calculate the
    non-relativistic magnitude of the gravitational force
    between the two objects

    -----output---------------
    The function returns a value with three decmil point
    precision. This value is the Newtons of gravitational
    The force felt by each of the two objects due to the gravity
    of the other object

    '''
    G = 6.6743e-11 #m^3kg^-1s^-2 gravitational constant
    
    #netwons law of universal gravitation
    force = (G * mass1*mass2)/(radius**2)         #calculating the force
    force_exp = f"{force:.3e}"   #changing the result ito exponetial notation
    return(force_exp)
    
